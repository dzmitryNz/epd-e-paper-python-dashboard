{
    "display": {
        "epdDisplayType": "env.EPD_MODEL",
        "epdDisplayWidth": "env.EPD_WIDTH",
        "epdDisplayHeight": "env.EPD_HEIGHT",
        "epdDisplayRotation": "env.EPD_ROTATION",
        "epdColourMode": "4GRAY",
        "colours": ["GRAY1", "GRAY2", "GRAY3", "GRAY4"],
        "oldDataColour": "GRAY3"
    },
    "fonts": {
        "font15": ["Font.ttc", 15],
        "font18": ["Font.ttc", 18],
        "font24": ["Font.ttc", 24],
        "font40": ["Font.ttc", 40]
    },
    "layout": {
        "lineHeight": 25,
        "startX": 0,
        "iconsPath": "./icons/"
    },
    "services": {
        "kucoin": {
            "url": "env.KUCOIN_URL",
            "responseType": "json",
            "pairs": ["BTC-USDC", "LTC-USDC", "LINK-USDC"],
            "refreshInterval": 600000,
            "data": {
                "BTC-USDC": {"path": "last", "type": "int"},
                "LTC-USDC": {"path": "last", "type": "int"},
                "LINK-USDC": {"path": "last", "type": "float", "round": 2}
            }
        },
        "weather": {
            "url": "env.WEATHER_URL",
            "responseType": "json",
            "params": {
                "q": "Mogilev",
                "lang": "be",
                "units": "metric",
                "appid": "env.OPENWEATHERMAP_API_KEY"
            },
            "refreshInterval": 600000,
            "data": {
                "temp": {"path": "main.temp", "type": "float", "round": 1},
                "feels_like": {"path": "main.feels_like", "type": "float", "round": 1},
                "humidity": {"path": "main.humidity", "type": "int"},
                "pressure": {"path": "main.pressure", "type": "int"},
                "wind_speed": {"path": "wind.speed", "type": "float", "round": 1},
                "wind_deg": {"path": "wind.deg", "type": "int"},
                "clouds": {"path": "clouds.all", "type": "int"},
                "description": {"path": "weather[0].description", "type": "string"},
                "sunrise": {"path": "sys.sunrise", "type": "int"},
                "sunset": {"path": "sys.sunset", "type": "int"}
            }
        },
        "wifiiot_sensors_1": {
            "url": "env.SENSORS_URL_1",
            "responseType": "text",
            "refreshInterval": 600000,
            "data": {
                "dsw1": {"path": "dsw1", "type": "float", "round": 2},
                "dsw2": {"path": "dsw2", "type": "float", "round": 2}
            }
        },
        "wifiiot_sensors_2": {
            "url": "env.SENSORS_URL_2",
            "responseType": "text",
            "refreshInterval": 600000,
            "data": {
                "bmpt": {"path": "bmpt", "type": "float", "round": 2},
                "bmpp": {"path": "bmpp", "type": "float", "round": 2}
            }
        },
        "solopool": {
            "url": "env.SOLOPOOL_URL",
            "responseType": "json",
            "refreshInterval": 600000
        },
        "nano3stats": {
            "url": "env.NANO3STATS_URL",
            "authCookie": "env.NANO3STATS_AUTH",
            "responseType": "jsonp",
            "refreshInterval": 600000
        }
    },
    "dashboard": {
        "lines": [
            {
                "name": "datetime",
                "startY": 0,
                "afterY": 27,
                "items": [
                    {"type": "datetime", "format": "%a - %d %b - %H:%M", "font": "font24", "colour": "GRAY4"}
                ]
            },
            {
                "name": "sun_times",
                "afterY": 25,
                "items": [
                    {"type": "sunrise", "prefix": " ↑ ", "format": "%H:%M", "font": "font18", "colour": "GRAY4"},
                    {"type": "sunset", "prefix": "  ↓ ", "format": "%H:%M", "font": "font18", "colour": "GRAY4"},
                    {"type": "description", "prefix": "   ", "font": "font18", "colour": "GRAY4"}
                ]
            },
            {
                "name": "out_temp",
                "afterY": 25,
                "items": [
                    {"type": "text", "text": "Out, °C:", "font": "font18", "colour": "GRAY4"},
                    {"type": "dsw1", "category": "sensors", "font": "font24", "colour": "GRAY4", "startX": 70, "offsetY": -4},
                    {"type": "feels_like", "category": "weather", "prefix": " Адчув. ", "font": "font18", "colour": "GRAY4", "startX": 120},
                    {"type": "temp", "category": "weather", "prefix": " - ", "font": "font18", "colour": "GRAY4"}
                ]
            },
            {
                "name": "humidity_wind",
                "afterY": 25,
                "items": [
                    {"type": "text", "text": "Вільг, %:", "font": "font18", "colour": "GRAY4"},
                    {"type": "humidity", "category": "weather", "font": "font24", "colour": "GRAY4", "startX": 75, "offsetY": -4},
                    {"type": "wind_direction", "category": "weather", "prefix": "Вецер ", "font": "font18", "colour": "GRAY4", "startX": 120},
                    {"type": "wind_speed", "category": "weather", "prefix": ", ", "suffix": " мс", "font": "font18", "colour": "GRAY4"}
                ]
            },
            {
                "name": "pressure_clouds",
                "afterY": 23,
                "items": [
                    {"type": "text", "text": "Ціск, hPa:", "font": "font18", "colour": "GRAY4"},
                    {"type": "bmpp", "category": "sensors", "font": "font24", "colour": "GRAY4", "startX": 85, "offsetY": -4},
                    {"type": "clouds", "category": "weather", "prefix": "Вобл ", "suffix": " %", "font": "font18", "colour": "GRAY4", "startX": 170}
                ]
            },
            {
                "name": "balcony_bk",
                "afterY": 23,
                "items": [
                    {"type": "text", "text": "Бал, °C:", "font": "font18", "colour": "GRAY4"},
                    {"type": "dsw2", "category": "sensors", "font": "font18", "colour": "GRAY4", "startX": 70},
                    {"type": "text", "text": "ВК, °C:", "font": "font18", "colour": "GRAY4", "startX": 120},
                    {"type": "bmpt", "category": "sensors", "font": "font18", "colour": "GRAY4", "startX": 180}
                ]
            },
            {
                "name": "crypto",
                "afterY": 23,
                "items": [
                    {"type": "text", "text": "BTC", "font": "font18", "colour": "GRAY4", "afterX": 5},
                    {"type": "BTC-USDC", "category": "kucoin", "font": "font18", "colour": "GRAY4", "afterX": 20},
                    {"type": "text", "text": "LTC", "font": "font18", "colour": "GRAY4", "afterX": 5},
                    {"type": "LTC-USDC", "category": "kucoin", "font": "font18", "colour": "GRAY4", "afterX": 20},
                    {"type": "text", "text": "LINK", "font": "font18", "colour": "GRAY4", "afterX": 5},
                    {"type": "LINK-USDC", "category": "kucoin", "font": "font18", "colour": "GRAY4"}
                ]
            },
            {
                "name": "mining",
                "afterY": 25,
                "items": [
                    {"type": "blocks", "category": "solopool", "font": "font18", "colour": "GRAY4", "afterX": 6},
                    {"type": "hashrate", "category": "solopool", "prefix": "FB ", "suffix": "H/s", "format": "hashrate", "font": "font18", "colour": "GRAY4", "afterX": 6},
                    {"type": "luck", "category": "solopool", "suffix": " %", "font": "font18", "colour": "GRAY4", "afterX": 10},
                    {"type": "workingmode", "category": "nano3stats", "map": {"0": "Lo", "1": "Mi", "2": "Hi"}, "font": "font18", "colour": "GRAY4", "afterX": 6},
                    {"type": "workingstatus", "category": "nano3stats", "map": {"0": "Init", "1": "Fine", "2": "Idle"}, "font": "font18", "colour": "GRAY4", "afterX": 6},
                    {"type": "power", "category": "nano3stats", "suffix": "W", "font": "font18", "colour": "GRAY4"}
                ]
            },
            {
                "name": "verbs",
                "type": "verbs",
                "font": "font18",
                "lineHeight": 25,
                "colour": "GRAY4",
                "secondaryColour": "GRAY3"
            }
        ]
    }
}
