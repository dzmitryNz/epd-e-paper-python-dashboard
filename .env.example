# --- Display model parameters ---
# Waveshare driver module name from lib/waveshare_epd (epd3in7, epd2in15g, ...)
EPD_MODEL=epd3in7
EPD_WIDTH=280
EPD_HEIGHT=480
EPD_ROTATION=0

# --- Local sensor services (WiFi-IoT boards) ---
SENSORS_URL_1=http://192.168.1.XXX/sensors
SENSORS_URL_2=http://192.168.1.XXX/sensors

# --- OpenWeatherMap ---
WEATHER_URL=https://api.openweathermap.org/data/2.5/weather
OPENWEATHERMAP_API_KEY=your-openweathermap-api-key

# --- KuCoin (public market API, no key required) ---
KUCOIN_URL=https://api.kucoin.com/api/v1/market/allTickers
KUCOIN_API_KEY=optional-not-used-yet

# --- Solopool mining stats (wallet address is part of the URL) ---
SOLOPOOL_URL=https://fb.solopool.org/api/accounts/YOUR_WALLET_ADDRESS

# --- Nano3 miner dashboard (JSONP endpoint on the miner) ---
NANO3STATS_URL=http://192.168.1.XXX/get_dashboard.cgi
NANO3STATS_AUTH=your-auth-cookie-value

# --- Home Assistant (garage automation status, see garageManager project) ---
# HA_URL is the base URL only, no trailing slash and no /api.
# If Home Assistant runs on the same home LAN as this board, a plain
# http://<home-server-ip>:8123 is enough. If it's only reachable over
# Tailscale, install Tailscale on this board too and use the Tailscale
# hostname/IP (100.x.x.x) instead.
# HA_TOKEN is a long-lived access token: Home Assistant profile page ->
# Security tab -> "Long-lived access tokens" -> Create Token.
HA_URL=http://192.168.1.XXX:8123
HA_TOKEN=your-long-lived-access-token
